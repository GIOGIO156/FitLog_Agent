#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Locally retained release APK artifacts
/artifacts/release-apks/*.apk
/artifacts/release-apks/SHA256SUMS.txt

# Locally retained diagnostic Debug APK artifacts
/artifacts/debug-apks/*.apk

# Local build configuration
/config/supabase.local.json
/supabase/.env*.local
/supabase/.temp/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/.kotlin/
/android/app/debug
/android/app/profile
/android/app/release
